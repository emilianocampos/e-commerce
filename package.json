{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true});console.log('.next cache limpiado exitosamente');}catch(e){console.error(e)}\"",
    "dev": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev --turbo",
    "dev:clean": "npm run clean && npm run dev",
    "dev:webpack": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "mercadopago": "^3.1.0",
    "next": "16.2.9",
    "nextjs-toast-notify": "^1.62.0",
    "nextjs-toploader": "^3.9.17",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
